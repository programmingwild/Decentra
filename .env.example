# Decentra Environment — copy to .env and fill in secrets.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development  # set to "production" for real deploys (refuses default SECRET_KEY)
DATABASE_URL=sqlite+aiosqlite:///./decentra.db
# For Postgres: postgresql+asyncpg://decentra:decentra@localhost:5432/decentra
SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Providers (AI_PROVIDER = local | openai | groq; keys stay in env, never in code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER=local
ANTHROPIC_API_KEY=
STORAGE_PATH=./storage
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
OPEN_REGISTRATION=true  # false = demo/single-user instance (seeded accounts only)
COOKIE_SAMESITE=lax  # lax (default, same-site) | strict | none (split public domains, needs https)
DOCS_ENABLED=true
MAX_UPLOAD_MB=50
MAX_RECORDING_MB=200
LOG_LEVEL=INFO

# Realtime (consumer load)
ASSISTANT_CACHE_TTL_SECONDS=3600
MEETINGS_CACHE_TTL_SECONDS=900
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
RATE_LIMIT_STORAGE_URI=  # empty = per-process memory; prod: redis://redis:6379
UVICORN_WORKERS=2

# Web (same-origin by default: leave NEXT_PUBLIC_API_URL unset and the
# Next.js proxy forwards /api/v1/* to API_INTERNAL_URL at request time)
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://localhost:8000

# Error tracking (optional — unset = fully disabled)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Production database password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
