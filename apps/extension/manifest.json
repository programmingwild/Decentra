{
  "manifest_version": 3,
  "name": "Decentra Meet Capture",
  "version": "1.0.0",
  "description": "Capture Google Meet live captions into Decentra — decisions, owners and evidence, pinned to the second spoken.",
  "permissions": ["storage", "tabs", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Decentra capture" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
